# Example environment variables for development and deployment.
# This file is safe to commit. Do NOT put real secrets here.

# Supabase project URL (example)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key - DO NOT commit real key here.
# This key must be server-only and never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=svc-REPLACE_WITH_SERVICE_ROLE_KEY

# Session signing secret used by the backend. Use a long random string in production.
SESSION_SECRET=replace-with-a-random-secret

# Optional: other server-side secrets may be added here.

# Local development only: copy this file to .env.local and fill real values.
# Example:
# cp .env.example .env.local
# Then edit .env.local to set real secrets.
